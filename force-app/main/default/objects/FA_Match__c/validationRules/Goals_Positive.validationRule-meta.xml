<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Goals_Positive</fullName>
    <active>true</active>
    <description>Les buts ne peuvent pas être un nombre négatif</description>
    <errorConditionFormula>OR(
  AND(NOT(ISBLANK(Goals_For__c)),     Goals_For__c     &lt; 0),
  AND(NOT(ISBLANK(Goals_Against__c)), Goals_Against__c &lt; 0)
)</errorConditionFormula>
    <errorMessage>Le nombre de buts ne peut pas être négatif.</errorMessage>
</ValidationRule>
