<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- apexClassAccesses / applicationVisibilities are rejected by the Metadata API parser
         in all tested positions. Add DHC_AppController via Setup > Permission Sets > DHC Admin
         > Edit > Apex Class Access > Enable DHC_AppController. -->
    <label>DHC Admin</label>
    <description>DHC — Full read/create/edit access for DHC piloting. Includes ViewSetup required to read ObjectPermissions and FieldPermissions (sessions 5-6).</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- userPermissions > ViewSetup (View Setup and Configuration) — required to query
         ObjectPermissions, FieldPermissions, and other setup objects via SOQL in Apex.
         Without this permission, queries on these objects return no rows even for
         System Administrators running in USER_MODE. -->
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewRoles</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewSetup</name>
    </userPermissions>

    <!-- Object permissions — read, create, edit (no delete) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>DHC_Component__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>DHC_Deployment__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>DHC_Finding__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Field permissions — DHC_Component__c -->
    <!-- DHC_API_Name__c omis : champ Required, les champs Required n'ont pas de FLS -->
    <fieldPermissions>
        <editable>true</editable>
        <field>DHC_Component__c.DHC_Baseline_Hash__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>DHC_Component__c.DHC_Baseline_State__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>DHC_Component__c.DHC_Change_Count__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>DHC_Component__c.DHC_Component_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>DHC_Component__c.DHC_Current_Hash__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>DHC_Component__c.DHC_Current_State__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- DHC_Has_Changed__c is a formula field — read only -->
    <fieldPermissions>
        <editable>false</editable>
        <field>DHC_Component__c.DHC_Has_Changed__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>DHC_Component__c.DHC_Is_Absent__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
